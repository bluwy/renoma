{
  "name": "renoma",
  "version": "0.4.0",
  "description": "Opinionated package health checks",
  "type": "module",
  "author": "Bjorn Lu",
  "license": "MIT",
  "bin": "./src/index.js",
  "scripts": {
    "cli": "node src/index.js",
    "lint": "prettier \"**/*.{js,md}\" --check",
    "format": "prettier \"**/*.{js,md}\" --write",
    "typecheck": "tsc",
    "test": "node --test test/index.js"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluwy/renoma.git"
  },
  "bugs": {
    "url": "https://github.com/bluwy/renoma/issues"
  },
  "packageManager": "pnpm@10.17.0",
  "dependencies": {
    "@eslint/json": "^0.13.2",
    "eslint": "^9.36.0",
    "eslint-plugin-depend": "^1.3.0",
    "eslint-plugin-regexp": "^2.10.0",
    "picocolors": "^1.1.1",
    "publint": "^0.3.13"
  },
  "devDependencies": {
    "@humanwhocodes/momoa": "^3.3.9",
    "@types/node": "^24.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
